{
  "$schema": "../schemas/design-system-contract.schema.json",
  "name": "material",
  "version": "1.0.0",
  "description": "Material Design 3 design system contract. Extends minimal with Material-specific style variants.",
  "layer": "design-system",
  "extends": "minimal",
  "requiredStyles": {
    "FsButton": {
      "implicit": {
        "description": "Filled button (Material primary filled style)",
        "requiredSetters": ["BackgroundColor", "TextColor"]
      },
      "named": [
        {
          "name": "OutlinedButton",
          "description": "Button with outline border and transparent background",
          "requiredSetters": ["BorderColor", "BorderWidth", "TextColor"]
        },
        {
          "name": "TextButton",
          "description": "Text-only button with no background or border",
          "requiredSetters": ["TextColor"]
        },
        {
          "name": "TonalButton",
          "description": "Button with secondary container background",
          "requiredSetters": ["BackgroundColor", "TextColor"]
        }
      ]
    },
    "FsCard": {
      "implicit": {
        "description": "Filled card (Material surface color)",
        "requiredSetters": ["BackgroundColor"]
      },
      "named": [
        {
          "name": "ElevatedCard",
          "description": "Card with shadow elevation",
          "requiredSetters": ["BackgroundColor", "Elevation"]
        },
        {
          "name": "OutlinedCard",
          "description": "Card with outline border",
          "requiredSetters": ["BackgroundColor", "BorderColor", "BorderWidth"]
        }
      ]
    },
    "FsEntry": {
      "implicit": {
        "description": "Filled text field (Material filled style)",
        "requiredSetters": ["Background", "TextColor", "PlaceholderColor"]
      },
      "named": [
        {
          "name": "OutlinedEntry",
          "description": "Text field with outline border",
          "requiredSetters": ["BorderBrush", "BorderWidth", "TextColor", "PlaceholderColor"]
        }
      ]
    },
    "FsEditor": {
      "implicit": {
        "description": "Filled multi-line text field",
        "requiredSetters": ["Background", "TextColor", "PlaceholderColor"]
      },
      "named": [
        {
          "name": "OutlinedEditor",
          "description": "Multi-line text field with outline border",
          "requiredSetters": ["BorderBrush", "BorderWidth", "TextColor", "PlaceholderColor"]
        }
      ]
    }
  },
  "recommendedStyles": {
    "FsButton": {
      "named": [
        {
          "name": "SecondaryButton",
          "description": "Button with secondary color"
        },
        {
          "name": "TertiaryButton",
          "description": "Button with tertiary color"
        },
        {
          "name": "ErrorButton",
          "description": "Button for destructive actions"
        }
      ]
    }
  },
  "metadata": {
    "author": "FlagstoneUI",
    "license": "MIT",
    "repository": "https://github.com/AnnexCreative/flagstone-ui",
    "documentation": "https://flagstoneui.dev/docs/contracts/material"
  }
}
