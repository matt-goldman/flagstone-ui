{
  "$schema": "../schemas/design-system-contract.schema.json",
  "name": "minimal",
  "version": "1.0.0",
  "description": "The minimum viable contract for a valid FlagstoneUI theme. Requires implicit styles for all Fs* controls.",
  "layer": "theme",
  "stylingSurface": {
