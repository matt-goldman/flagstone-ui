        "inheritsFrom": "Microsoft.Maui.Controls.Button",
        "architecture": "subclass",
        "styledProperties": [
          { "name": "BackgroundColor", "type": "color", "tokenCategory": "colors", "recommendedToken": "Color.Primary" },
          { "name": "TextColor", "type": "color", "tokenCategory": "colors", "recommendedToken": "Color.OnPrimary" },
          { "name": "BorderColor", "type": "color", "tokenCategory": "colors", "recommendedToken": "Color.Outline" },
          { "name": "BorderWidth", "type": "double", "tokenCategory": "borderWidth", "recommendedToken": "BorderWidth.None" },
