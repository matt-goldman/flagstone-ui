<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlagstoneUI.BootstrapConverter.UI.Controls.EntryShowcase">
  <FsCard Style="{DynamicResource SlateProCard}">
    <VerticalStackLayout Spacing="20">
      <Label x:Name="StyleNameLabel"
             TextColor="White"
             Text="This will be the style name"/>

      <FsEntry x:Name="NormalEntry"
               WidthRequest="200"
               Placeholder="Normal Entry" />

      <FsEntry x:Name="DisabledEntry"
               Placeholder="Disabled Entry"
               WidthRequest="200"
               IsEnabled="False" />
    </VerticalStackLayout>
  </FsCard>
</ContentView>
