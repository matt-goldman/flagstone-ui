<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="FlagstoneUI.BootstrapConverter.UI.Controls.ButtonShowcase">
  <FsCard Style="{DynamicResource SlateProCard}">
    <VerticalStackLayout Spacing="20">
      <Label x:Name="StyleNameLabel" />

      <FsButton x:Name="NormalButton"
                Text="Normal" />

      <FsButton x:Name="DisabledButton"
                Text="Disabled"
                IsEnabled="False" />
    </VerticalStackLayout>
  </FsCard>
</ContentView>