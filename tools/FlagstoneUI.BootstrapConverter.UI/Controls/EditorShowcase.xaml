<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlagstoneUI.BootstrapConverter.UI.Controls.EditorShowcase">
  <FsCard Style="{DynamicResource SlateProCard}">
    <VerticalStackLayout Spacing="20">
      <Label x:Name="StyleNameLabel"
             TextColor="White"
             Text="This will be the style name"/>

      <FsEditor x:Name="NormalEditor"
                WidthRequest="200"
                HeightRequest="100"
                Placeholder="Normal Editor" />

      <FsEditor x:Name="DisabledEditor"
                Placeholder="Disabled Editor"
                WidthRequest="200"
                HeightRequest="100"
                IsEnabled="False" />
    </VerticalStackLayout>
  </FsCard>
</ContentView>
