<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlagstoneUI.BootstrapConverter.UI.MainPage">

  <Grid ColumnDefinitions="300,*">
    
    <!-- Input options -->
    <VerticalStackLayout Spacing="20">
      <VerticalStackLayout Spacing="10" Padding="10">
        <Label Text="Bootstrap Converter" FontSize="24" FontAttributes="Bold" />
        <Label Text="Convert Bootstrap themes to Flagstone UI XAML resources." FontSize="14" />
      </VerticalStackLayout>

      <!-- Theme source (file or URL) -->
      <!-- TODO: make this multiples as may include variables etc. -->
      <VerticalStackLayout Spacing="10" Padding="10">
        <Label Text="Theme source" FontSize="18" FontAttributes="Bold" />
        <Button Text="Select Bootstrap CSS File" />
        <Button Text="Select Output Directory" />
      </VerticalStackLayout>

      <!-- Theme name -->
      <VerticalStackLayout Spacing="10" Padding="10">
        <Label Text="Theme name" FontSize="18" FontAttributes="Bold" />
        <Entry Placeholder="Enter theme name" />
      </VerticalStackLayout>
      
      <!-- Options -->
      
      <VerticalStackLayout Spacing="10" Padding="10">
        <Label Text="Options" FontSize="18" FontAttributes="Bold" />
        <CheckBox Content="Include comments in output" IsChecked="True" />
        <CheckBox Content="Include fonts" IsChecked="True" />
        <Label Text="Output format" />
        <Picker>
          <Picker.Items>
            <x:String>XAML</x:String>
            <x:String>C#</x:String>
          </Picker.Items>
        </Picker>
        <Label Text="Dark mode strategy" />
        <Picker>
          <Picker.Items>
            <x:String>Separate ResourceDictionary</x:String>
            <x:String>Merged ResourceDictionary</x:String>
            <x:String>Inline</x:String>
          </Picker.Items>
        </Picker>
        <Label Text="Namespace" />
        <Entry Placeholder="Enter namespace" Text="FlagstoneUI.Themes" />
        <Label Text="Analysis strategy" />
        <Picker>
          <Picker.Items>
            <x:String>Comprehensive</x:String>
            <x:String>Fast</x:String>
          </Picker.Items>
        </Picker>
        <Label Text="CSS Format" />
        <Picker>
          <Picker.Items>
            <x:String>Auto-detect</x:String>
            <x:String>CSS</x:String>
            <x:String>SCSS</x:String>
          </Picker.Items>
        </Picker>
      </VerticalStackLayout>

      <VerticalStackLayout Spacing="10" Padding="10">
        <Button Text="Convert Theme" BackgroundColor="#512BD4" TextColor="White" />
        <Label Text="Conversion Results" FontSize="18" FontAttributes="Bold" />
        <ScrollView HeightRequest="200">
          <Label Text="Conversion log will appear here..." />
        </ScrollView>
        <Button Text="Save Output" IsEnabled="False" BackgroundColor="#512BD4" TextColor="White" />
      </VerticalStackLayout>


    </VerticalStackLayout>

    <!-- Controls showcase -->
    <ScrollView>
      <VerticalStackLayout Spacing="20">
        <!-- Heading section-->
        <VerticalStackLayout Spacing="10" Padding="10">
          <Label Text="Controls Preview" FontSize="24" FontAttributes="Bold" />
          <Label Text="This area will showcase various Flagstone UI controls styled with the converted theme." FontSize="14" />
        </VerticalStackLayout>

        <!-- FsButton -->
        <VerticalStackLayout Spacing="10" Padding="10">
          <Label Text="Buttons" FontSize="18" FontAttributes="Bold" />
          <FlexLayout Direction="Row" AlignContent="Start" JustifyContent="SpaceEvenly">
            <Button Text="Primary Button" />
            <Button Text="Secondary Button" BackgroundColor="Gray" TextColor="White" />
            <Button Text="Success Button" BackgroundColor="Green" TextColor="White" />
          </FlexLayout>
        </VerticalStackLayout>

        <!-- FsEntry -->
        <VerticalStackLayout Spacing="10" Padding="10">
          <Label Text="Entries" FontSize="18" FontAttributes="Bold" />
          <FlexLayout Direction="Row" AlignContent="Start" JustifyContent="SpaceEvenly">
            <Entry Placeholder="Default Entry" WidthRequest="200" />
            <Entry Placeholder="Disabled Entry" IsEnabled="False" WidthRequest="200" />
          </FlexLayout>
        </VerticalStackLayout>

        <!-- FsEditor -->
        <VerticalStackLayout Spacing="10" Padding="10">
          <Label Text="Editors" FontSize="18" FontAttributes="Bold" />
          <FlexLayout Direction="Row" AlignContent="Start" JustifyContent="SpaceEvenly">
            <Editor Placeholder="Default Editor" WidthRequest="200" HeightRequest="100" />
            <Editor Placeholder="Disabled Editor" IsEnabled="False" WidthRequest="200" HeightRequest="100" />
          </FlexLayout>
        </VerticalStackLayout>
        
        <!-- FsCard -->
        <VerticalStackLayout Spacing="10" Padding="10">
          <Label Text="Cards" FontSize="18" FontAttributes="Bold" />
          <FlexLayout Direction="Row" AlignContent="Start" JustifyContent="SpaceEvenly">
            <!-- TODO: add cards here -->

            
          </FlexLayout>
        </VerticalStackLayout>

      </VerticalStackLayout>
    </ScrollView>
  </Grid>

</ContentPage>
