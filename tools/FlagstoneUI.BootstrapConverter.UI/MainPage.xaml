<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FlagstoneUI.BootstrapConverter.UI.MainPage"
             x:DataType="MainViewModel">

  <Grid ColumnDefinitions="400,*">
    
    <!-- Input options -->
    <ScrollView>
      <VerticalStackLayout Spacing="20">
        <VerticalStackLayout Spacing="10" Padding="10">
          <Label Text="Bootstrap Converter" FontSize="24" FontAttributes="Bold" />
          <Label Text="Convert Bootstrap themes to Flagstone UI XAML resources." FontSize="14" />
        </VerticalStackLayout>

        <!-- Theme source (file or URL) -->
        <!-- TODO: make this multiples as may include variables etc. -->
        <VerticalStackLayout Spacing="10" Padding="10">
          <Label Text="Theme source" FontSize="18" FontAttributes="Bold" />
          <FsButton Style="{DynamicResource SlateProButton}"  Text="Select Bootstrap CSS File" />
          <FsButton Style="{DynamicResource SlateProButton}" Text="Select Output Directory" />
        </VerticalStackLayout>

        <!-- Theme name -->
        <VerticalStackLayout Spacing="10" Padding="10">
          <Label Text="Theme name" FontSize="18" FontAttributes="Bold" />
          <FsEntry Style="{DynamicResource SlateProEntry}"  Placeholder="Enter theme name" />
        </VerticalStackLayout>

        <!-- Options -->

        <VerticalStackLayout Spacing="10" Padding="10">
          <Label Text="Options" FontSize="18" FontAttributes="Bold" />
          <Grid ColumnDefinitions="*, 30"
          RowDefinitions="*,*">
            <Label Grid.Row="0"
             Grid.Column="0"
             Text="Include comments in output"/>
            <CheckBox Grid.Row="0"
                Grid.Column="1"
                IsChecked="{Binding IncludeComments}" />
            <Label Grid.Row="1"
             Grid.Column="0"
             Text="Include fonts" />
            <CheckBox Grid.Column="1"
                Grid.Row="1"
                IsChecked="{Binding IncludeFonts}" />
          </Grid>


          <Label Text="Output format" />
          <Picker ItemsSource="{Binding ResourceDictionaryFormats}"
            SelectedItem="{Binding OutputType}" />
          <Label Text="Dark mode strategy" />
          <Picker ItemsSource="{Binding DarkModeStrategies}"
            SelectedItem="{Binding DarkModeStrategy}" />
          <Label Text="Namespace" />
          <Entry Placeholder="Enter namespace" Text="FlagstoneUI.Themes" />
          <Label Text="Analysis strategy" />
          <Picker ItemsSource="{Binding AnalysisStrategies}"
            SelectedItem="{Binding AnalysisStrategy}" />
          <Label Text="CSS Format" />
          <Picker ItemsSource="{Binding BootstrapFormats}"
            SelectedItem="{Binding BootstrapFormat}" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="10" Padding="10">
          <FsButton Style="{DynamicResource SlateProButton}"  Text="Convert Theme" />
          <Label Text="Conversion Results" FontSize="18" FontAttributes="Bold" />
          <ScrollView HeightRequest="200">
            <Label Text="Conversion log will appear here..." />
          </ScrollView>
          <FsButton Style="{DynamicResource SlateProButton}" Text="Save Output" IsEnabled="False" />
        </VerticalStackLayout>


      </VerticalStackLayout>
    </ScrollView>

    <!-- Controls showcase -->
    <ScrollView Grid.Column="1">
      <VerticalStackLayout Spacing="30">
        <!-- Heading section-->
        <VerticalStackLayout Spacing="10" Padding="10">
          <Label Text="Controls Preview" FontSize="24" FontAttributes="Bold" />
          <Label Text="This area will showcase various Flagstone UI controls styled with the converted theme." FontSize="14" />
        </VerticalStackLayout>

        <!-- FsButton -->
        <VerticalStackLayout Spacing="10" Padding="10">
          <Label Text="Buttons" FontSize="18" FontAttributes="Bold" />
          <FlexLayout Direction="Row" AlignContent="Start" JustifyContent="SpaceEvenly">
            <FsButton Text="Primary Button" />
            <FsButton Style="{DynamicResource SecondaryButton}"  Text="Secondary Button" />
            <FsButton Style="{DynamicResource SuccessButton}" Text="Success Button" />
          </FlexLayout>
        </VerticalStackLayout>

        <!-- FsEntry -->
        <VerticalStackLayout Spacing="10" Padding="10">
          <Label Text="Entries" FontSize="18" FontAttributes="Bold" />
          <FlexLayout Direction="Row" AlignContent="Start" JustifyContent="SpaceEvenly">
            <FsEntry Placeholder="Default Entry" WidthRequest="200" />
            <FsEntry Placeholder="Disabled Entry" IsEnabled="False" WidthRequest="200" />
          </FlexLayout>
        </VerticalStackLayout>

        <!-- FsEditor -->
        <VerticalStackLayout Spacing="10" Padding="10">
          <Label Text="Editors" FontSize="18" FontAttributes="Bold" />
          <FlexLayout Direction="Row" AlignContent="Start" JustifyContent="SpaceEvenly">
            <FsEditor Placeholder="Default Editor" WidthRequest="200" HeightRequest="100" />
            <FsEditor Placeholder="Disabled Editor" IsEnabled="False" WidthRequest="200" HeightRequest="100" />
          </FlexLayout>
        </VerticalStackLayout>
        
        <!-- FsCard -->
        <VerticalStackLayout Spacing="10" Padding="10">
          <Label Text="Cards" FontSize="18" FontAttributes="Bold" />
          <FlexLayout Direction="Row" AlignContent="Start" JustifyContent="SpaceEvenly">
            <!-- TODO: add cards here -->

            
          </FlexLayout>
        </VerticalStackLayout>

      </VerticalStackLayout>
    </ScrollView>
  </Grid>

</ContentPage>
