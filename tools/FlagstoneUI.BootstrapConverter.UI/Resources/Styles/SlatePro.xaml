<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:fs="clr-namespace:FlagstoneUI.Core.Controls;assembly=FlagstoneUI.Core"
                    xmlns:tokens="clr-namespace:FlagstoneUI.Core.Styles;assembly=FlagstoneUI.Core"
                    x:Class="FlagstoneUI.BootstrapConverter.UI.Resources.Styles.SlatePro">

  <ResourceDictionary.MergedDictionaries>
    <tokens:Tokens />
  </ResourceDictionary.MergedDictionaries>

 <!-- ======================================================= -->
  <!--  COLOR TOKENS (SlatePro Professional Palette)           -->
  <!-- ======================================================= -->

  <!-- Primary (Enterprise Blue) -->
  <Color x:Key="Sp.Color.Primary">#0B62A4</Color>
  <Color x:Key="Sp.Color.OnPrimary">#FFFFFF</Color>
  <Color x:Key="Sp.Color.PrimaryContainer">#D5E8F8</Color>
  <Color x:Key="Sp.Color.OnPrimaryContainer">#06273E</Color>

  <!-- Secondary (Neutral Slate Gray) -->
  <Color x:Key="Sp.Color.Secondary">#6E7782</Color>
  <Color x:Key="Sp.Color.OnSecondary">#FFFFFF</Color>
  <Color x:Key="Sp.Color.SecondaryContainer">#E1E5EB</Color>
  <Color x:Key="Sp.Color.OnSecondaryContainer">#22272E</Color>

  <!-- Tertiary (Teal Accent, sparingly used) -->
  <Color x:Key="Sp.Color.Tertiary">#2A8F78</Color>
  <Color x:Key="Sp.Color.OnTertiary">#FFFFFF</Color>
  <Color x:Key="Sp.Color.TertiaryContainer">#C5F2E6</Color>
  <Color x:Key="Sp.Color.OnTertiaryContainer">#06382F</Color>

  <!-- Error -->
  <Color x:Key="Sp.Color.Error">#B3261E</Color>
  <Color x:Key="Sp.Color.OnError">#FFFFFF</Color>
  <Color x:Key="Sp.Color.ErrorContainer">#F9DEDC</Color>
  <Color x:Key="Sp.Color.OnErrorContainer">#410002</Color>

  <!-- Surface / Background -->
  <Color x:Key="Sp.Color.Surface">#FFFFFF</Color>
  <Color x:Key="Sp.Color.OnSurface">#1B1B1F</Color>
  <Color x:Key="Sp.Color.SurfaceVariant">#E6E8EC</Color>
  <Color x:Key="Sp.Color.OnSurfaceVariant">#494D53</Color>
  <Color x:Key="Sp.Color.Background">#F5F6F7</Color>
  <Color x:Key="Sp.Color.OnBackground">#1B1B1F</Color>

  <!-- Outline -->
  <Color x:Key="Sp.Color.Outline">#75777D</Color>
  <Color x:Key="Sp.Color.OutlineVariant">#C4C6CC</Color>

  <!-- Inverse -->
  <Color x:Key="Sp.Color.InverseSurface">#2F3135</Color>
  <Color x:Key="Sp.Color.InverseOnSurface">#F2F3F5</Color>
  <Color x:Key="Sp.Color.InversePrimary">#93C9F4</Color>

  <!-- ======================================================= -->
  <!--  BORDER RADIUS TOKENS                                   -->
  <!-- ======================================================= -->

  <!-- Border radius tokens (Double for FsCard, FsEntry, FsEditor) -->
  <x:Double x:Key="Sp.Radius.None">0</x:Double>
  <x:Double x:Key="Sp.Radius.ExtraSmall">4</x:Double>
  <x:Double x:Key="Sp.Radius.Small">8</x:Double>
  <x:Double x:Key="Sp.Radius.Medium">12</x:Double>
  <x:Double x:Key="Sp.Radius.Large">16</x:Double>
  <x:Double x:Key="Sp.Radius.ExtraLarge">28</x:Double>
  <x:Double x:Key="Sp.Radius.Full">9999</x:Double>

  <!-- Border radius tokens (Int32 for Button.CornerRadius) -->
  <x:Int32 x:Key="Sp.Radius.Button.None">0</x:Int32>
  <x:Int32 x:Key="Sp.Radius.Button.ExtraSmall">4</x:Int32>
  <x:Int32 x:Key="Sp.Radius.Button.Small">8</x:Int32>
  <x:Int32 x:Key="Sp.Radius.Button.Medium">12</x:Int32>
  <x:Int32 x:Key="Sp.Radius.Button.Large">16</x:Int32>
  <x:Int32 x:Key="Sp.Radius.Button.ExtraLarge">28</x:Int32>
  <x:Int32 x:Key="Sp.Radius.Button.Full">9999</x:Int32>

  <!-- ======================================================= -->
  <!--  SPACING TOKENS                                         -->
  <!-- ======================================================= -->

  <x:Double x:Key="Sp.Space.0">0</x:Double>
  <x:Double x:Key="Sp.Space.2">2</x:Double>
  <x:Double x:Key="Sp.Space.4">4</x:Double>
  <x:Double x:Key="Sp.Space.8">8</x:Double>
  <x:Double x:Key="Sp.Space.12">12</x:Double>
  <x:Double x:Key="Sp.Space.16">16</x:Double>
  <x:Double x:Key="Sp.Space.20">20</x:Double>
  <x:Double x:Key="Sp.Space.24">24</x:Double>
  <x:Double x:Key="Sp.Space.32">32</x:Double>
  <x:Double x:Key="Sp.Space.40">40</x:Double>
  <x:Double x:Key="Sp.Space.48">48</x:Double>

  <!-- ======================================================= -->
  <!--  TYPOGRAPHY TOKENS                                      -->
  <!-- ======================================================= -->

  <x:Double x:Key="Sp.FontSize.DisplayLarge">57</x:Double>
  <x:Double x:Key="Sp.FontSize.DisplayMedium">45</x:Double>
  <x:Double x:Key="Sp.FontSize.DisplaySmall">36</x:Double>
  <x:Double x:Key="Sp.FontSize.HeadlineLarge">32</x:Double>
  <x:Double x:Key="Sp.FontSize.HeadlineMedium">28</x:Double>
  <x:Double x:Key="Sp.FontSize.HeadlineSmall">24</x:Double>
  <x:Double x:Key="Sp.FontSize.TitleLarge">22</x:Double>
  <x:Double x:Key="Sp.FontSize.TitleMedium">16</x:Double>
  <x:Double x:Key="Sp.FontSize.TitleSmall">14</x:Double>
  <x:Double x:Key="Sp.FontSize.BodyLarge">16</x:Double>
  <x:Double x:Key="Sp.FontSize.BodyMedium">14</x:Double>
  <x:Double x:Key="Sp.FontSize.BodySmall">12</x:Double>
  <x:Double x:Key="Sp.FontSize.LabelLarge">14</x:Double>
  <x:Double x:Key="Sp.FontSize.LabelMedium">12</x:Double>
  <x:Double x:Key="Sp.FontSize.LabelSmall">11</x:Double>

  <!-- Legacy aliases for backward compatibility -->
  <x:Double x:Key="Sp.FontSize.Body">14</x:Double>
  <x:Double x:Key="Sp.FontSize.Title">20</x:Double>

  <!-- ======================================================= -->
  <!--  BORDER WIDTH TOKENS                                    -->
  <!-- ======================================================= -->

  <x:Double x:Key="Sp.BorderWidth.None">0</x:Double>
  <x:Double x:Key="Sp.BorderWidth.Thin">1</x:Double>
  <x:Double x:Key="Sp.BorderWidth.Thick">2</x:Double>
  <x:Double x:Key="Sp.BorderWidth.Heavy">4</x:Double>

  <!-- ======================================================= -->
  <!--  OPACITY TOKENS                                         -->
  <!-- ======================================================= -->

  <x:Double x:Key="Sp.Opacity.Disabled">0.38</x:Double>
  <x:Double x:Key="Sp.Opacity.Medium">0.74</x:Double>
  <x:Double x:Key="Sp.Opacity.High">0.87</x:Double>
  <x:Double x:Key="Sp.Opacity.Full">1.0</x:Double>

  <!-- ======================================================= -->
  <!--  CONTROL STYLES                                         -->
  <!-- ======================================================= -->

  <!-- ========== FsButton (Minimal Professional - implicit default) ========== -->
  <Style x:Key="SlateProButton" TargetType="fs:FsButton">
    <Setter Property="BackgroundColor" Value="{DynamicResource Sp.Color.Primary}" />
    <Setter Property="TextColor" Value="{DynamicResource Sp.Color.OnPrimary}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sp.Radius.Button.Small}" />
    <Setter Property="FontSize" Value="{DynamicResource Sp.FontSize.LabelLarge}" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="HeightRequest" Value="40" />
    <Setter Property="BorderWidth" Value="{DynamicResource Sp.BorderWidth.None}" />
    <Setter Property="BorderColor" Value="Transparent" />
    <Setter Property="VisualStateManager.VisualStateGroups">
      <VisualStateGroupList>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Property="Opacity" Value="{DynamicResource Sp.Opacity.Disabled}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </Setter>
  </Style>

  <!-- ========== Secondary Button ========== -->
  <Style x:Key="SlateProSecondaryButton" TargetType="fs:FsButton">
    <Setter Property="BackgroundColor" Value="{DynamicResource Sp.Color.Secondary}" />
    <Setter Property="TextColor" Value="{DynamicResource Sp.Color.OnSecondary}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sp.Radius.Button.Small}" />
    <Setter Property="FontSize" Value="{DynamicResource Sp.FontSize.LabelLarge}" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="HeightRequest" Value="40" />
    <Setter Property="BorderWidth" Value="{DynamicResource Sp.BorderWidth.None}" />
    <Setter Property="BorderColor" Value="Transparent" />
    <Setter Property="VisualStateManager.VisualStateGroups">
      <VisualStateGroupList>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Property="Opacity" Value="{DynamicResource Sp.Opacity.Disabled}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </Setter>
  </Style>

  <!-- ========== Tertiary Button ========== -->
  <Style x:Key="SlateProTertiaryButton" TargetType="fs:FsButton">
    <Setter Property="BackgroundColor" Value="{DynamicResource Sp.Color.Tertiary}" />
    <Setter Property="TextColor" Value="{DynamicResource Sp.Color.OnTertiary}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sp.Radius.Button.Small}" />
    <Setter Property="FontSize" Value="{DynamicResource Sp.FontSize.LabelLarge}" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="HeightRequest" Value="40" />
    <Setter Property="BorderWidth" Value="{DynamicResource Sp.BorderWidth.None}" />
    <Setter Property="BorderColor" Value="Transparent" />
    <Setter Property="VisualStateManager.VisualStateGroups">
      <VisualStateGroupList>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Property="Opacity" Value="{DynamicResource Sp.Opacity.Disabled}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </Setter>
  </Style>

  <!-- ========== FsCard (implicit default) ========== -->
  <Style x:Key="SlateProCard" TargetType="fs:FsCard">
    <Setter Property="BackgroundBrush" Value="{AppThemeBinding Light={DynamicResource Sp.Color.Surface}, Dark={DynamicResource Sp.Color.SurfaceDark}}" />
    <!-- subtle LOB outline instead of elevation -->
    <Setter Property="BorderColor" Value="{DynamicResource Sp.Color.OutlineVariant}" />
    <Setter Property="BorderWidth" Value="{DynamicResource Sp.BorderWidth.Thin}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sp.Radius.Small}" />
    <Setter Property="Padding" Value="{DynamicResource Sp.Space.16}" />
    <Setter Property="Elevation" Value="0" />
  </Style>

  <!-- ========== FsEntry (implicit default) ========== -->
  <Style x:Key="SlateProEntry" TargetType="fs:FsEntry">
    <Setter Property="Background">
      <Setter.Value>
        <SolidColorBrush Color="{DynamicResource Sp.Color.Surface}" />
      </Setter.Value>
    </Setter>
    <Setter Property="TextColor" Value="{DynamicResource Sp.Color.OnSurface}" />
    <Setter Property="PlaceholderColor" Value="{DynamicResource Sp.Color.OnSurfaceVariant}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sp.Radius.Small}" />
    <Setter Property="FontSize" Value="{DynamicResource Sp.FontSize.BodyMedium}" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="HeightRequest" Value="40" />
    <Setter Property="BorderBrush">
      <Setter.Value>
        <SolidColorBrush Color="{DynamicResource Sp.Color.Outline}" />
      </Setter.Value>
    </Setter>
    <Setter Property="BorderWidth" Value="{DynamicResource Sp.BorderWidth.Thin}" />
  </Style>

  <!-- ========== FsEditor (implicit default) ========== -->
  <Style x:Key="SlateProEditor" TargetType="fs:FsEditor">
    <Setter Property="Background">
      <Setter.Value>
        <SolidColorBrush Color="{DynamicResource Sp.Color.Surface}" />
      </Setter.Value>
    </Setter>
    <Setter Property="TextColor" Value="{DynamicResource Sp.Color.OnSurface}" />
    <Setter Property="PlaceholderColor" Value="{DynamicResource Sp.Color.OnSurfaceVariant}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sp.Radius.Small}" />
    <Setter Property="FontSize" Value="{DynamicResource Sp.FontSize.BodyMedium}" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="MinimumHeightRequest" Value="120" />
    <Setter Property="BorderBrush">
      <Setter.Value>
        <SolidColorBrush Color="{DynamicResource Sp.Color.Outline}" />
      </Setter.Value>
    </Setter>
    <Setter Property="BorderWidth" Value="{DynamicResource Sp.BorderWidth.Thin}" />
  </Style>

  <!--  Outlined Editor Style  -->
    <Style x:Key="SlateProOutlinedEditor" TargetType="fs:FsEditor">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="Transparent" />
            </Setter.Value>
        </Setter>
        <Setter Property="TextColor" Value="{DynamicResource Sp.Color.OnBackground}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource Sp.Color.Secondary}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Sp.Radius.Small}" />
        <Setter Property="FontSize" Value="{DynamicResource Sp.FontSize.Body}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="120" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource Sp.Color.Primary}" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderWidth" Value="{DynamicResource Sp.BorderWidth.Thin}" />
    </Style>

</ResourceDictionary>
