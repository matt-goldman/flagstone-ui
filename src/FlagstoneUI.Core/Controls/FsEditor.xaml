<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fs="clr-namespace:FlagstoneUI.Core.Controls"
             x:Class="FlagstoneUI.Core.Controls.FsEditor"
             x:DataType="fs:FsEditor"
             x:Name="ViewWrapper">
    <!-- TODO: Add global XML usings -->
  <Border x:Name="WrapperBorder"
          Background="{Binding Background}"
          Stroke="{Binding BorderBrush}"
          StrokeThickness="{Binding BorderWidth}"
          StrokeShape="{Binding BorderShape}">
    <Grid MinimumHeightRequest="88">
      <fs:BorderlessEditor Text="{Binding Text}"
                           Placeholder="{Binding Placeholder}"
                           PlaceholderColor="{Binding PlaceholderColor}"
                           Background="{Binding Background}"
                           TextColor="{Binding TextColor}"
                           TextChanged="OnTextChanged"
                           Completed="OnCompleted"
                           FontSize="{Binding FontSize}"
                           HorizontalTextAlignment="{Binding HorizontalTextAlignment}"
                           VerticalTextAlignment="{Binding VerticalTextAlignment}"
                           Keyboard="{Binding Keyboard}"
                           AutoSize="{Binding AutoSize}"
                           MaxLength="{Binding MaxLength}"
                           IsReadOnly="{Binding IsReadOnly}"
                           Margin="{Binding Padding}"
                           VerticalOptions="Fill"
                           Focused="BorderlessEditor_Focused"
                           Unfocused="BorderlessEditor_Unfocused"
                           x:Name="InnerEditor"/>
    </Grid>
  </Border>
</ContentView>
