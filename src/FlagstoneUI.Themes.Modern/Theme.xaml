<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:fs="clr-namespace:FlagstoneUI.Core.Controls;assembly=FlagstoneUI.Core"
                    xmlns:tokens="clr-namespace:FlagstoneUI.Core.Styles;assembly=FlagstoneUI.Core"
                    x:Class="FlagstoneUI.Themes.Modern.Theme">
  <ResourceDictionary.MergedDictionaries>
    <tokens:Tokens />
  </ResourceDictionary.MergedDictionaries>

  <!-- Modern theme specific overrides and additional styles -->
  <Style TargetType="Label">
    <Setter Property="TextColor" Value="#222222" />
  </Style>

  <Style TargetType="fs:FsCard">
    <Setter Property="Padding" Value="{DynamicResource Space.12}" />
    <Setter Property="BackgroundColor" Value="#FFFFFF" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Large}" />
    <Setter Property="BorderColor" Value="#E0E0E0" />
  </Style>

  <Style TargetType="fs:FsEditor">
    <Setter Property="Background">
      <Setter.Value>
        <SolidColorBrush Color="#FFFFFF" />
      </Setter.Value>
    </Setter>
    <Setter Property="TextColor" Value="#222222" />
    <Setter Property="BorderBrush">
      <Setter.Value>
        <SolidColorBrush Color="#E0E0E0" />
      </Setter.Value>
    </Setter>
    <Setter Property="BorderWidth" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="MinimumHeightRequest" Value="120" />
  </Style>

</ResourceDictionary>
