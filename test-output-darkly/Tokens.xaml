<?xml version="1.0" encoding="utf-16"?>
<ResourceDictionary xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns="http://schemas.microsoft.com/dotnet/2021/maui">
    <!-- ===== Color Tokens ===== -->
    <!-- Color.Background: Body background color -->
    <Color x:Key="Color.Background">#222</Color>
    <!-- Color.Error: Error/danger state color -->
    <Color x:Key="Color.Error">#E74C3C</Color>
    <!-- Dark mode: #FF624E -->
    <!-- Color.Info: Info state color -->
    <Color x:Key="Color.Info">#3498DB</Color>
    <!-- Dark mode: #246A99 -->
    <!-- Color.OnBackground: Body text color -->
    <Color x:Key="Color.OnBackground">#ADB5BD</Color>
    <!-- Dark mode: #797E84 -->
    <!-- Color.Outline: Border color -->
    <Color x:Key="Color.Outline">#444</Color>
    <!-- Color.Primary: Primary brand color -->
    <Color x:Key="Color.Primary">#375A7F</Color>
    <!-- Dark mode: #4775A5 -->
    <!-- Color.Secondary: Secondary brand color -->
    <Color x:Key="Color.Secondary">#444</Color>
    <!-- Color.Success: Success state color -->
    <Color x:Key="Color.Success">#00BC8C</Color>
    <!-- Dark mode: #00F4B6 -->
    <!-- Color.Surface: Light surface color -->
    <Color x:Key="Color.Surface">#ADB5BD</Color>
    <!-- Dark mode: #797E84 -->
    <!-- Color.SurfaceVariant.Dark: Dark surface variant -->
    <Color x:Key="Color.SurfaceVariant.Dark">#303030</Color>
    <!-- Dark mode: #3E3E3E -->
    <!-- Color.Warning: Warning state color -->
    <Color x:Key="Color.Warning">#F39C12</Color>
    <!-- Dark mode: #AA6D0C -->
<!-- ===== Typography Tokens ===== --><!-- FontFamily.Default: Default font family --><x:String x:Key="FontFamily.Default">System</x:String><!-- FontSize.Body: Base body font size --><x:Double x:Key="FontSize.Body">15</x:Double><!-- LineHeight.Default: Default line height --><x:Double x:Key="LineHeight.Default">1.5</x:Double>
<!-- ===== Spacing Tokens ===== --><!-- Spacing.ExtraLarge: Extra large spacing --><x:Double x:Key="Spacing.ExtraLarge">48</x:Double><!-- Spacing.ExtraSmall: Extra small spacing --><x:Double x:Key="Spacing.ExtraSmall">4</x:Double><!-- Spacing.Large: Large spacing --><x:Double x:Key="Spacing.Large">24</x:Double><!-- Spacing.Medium: Medium spacing (base) --><x:Double x:Key="Spacing.Medium">16</x:Double><!-- Spacing.Small: Small spacing --><x:Double x:Key="Spacing.Small">8</x:Double>
<!-- ===== Corner Radius Tokens ===== --><!-- Radius.Large: Large corner radius --><x:Double x:Key="Radius.Large">4.8</x:Double><!-- Radius.Medium: Medium corner radius --><x:Double x:Key="Radius.Medium">4</x:Double><!-- Radius.Small: Small corner radius --><x:Double x:Key="Radius.Small">3.2</x:Double>
<!-- ===== Border Width Tokens ===== --><!-- BorderWidth.Default: Default border width --><x:Double x:Key="BorderWidth.Default">1</x:Double>
</ResourceDictionary>