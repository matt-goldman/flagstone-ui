<?xml version="1.0" encoding="UTF-8" ?>
<fs:FsShell
  x:Class="FlagstoneUI.SampleApp.DemoShell"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:fs="clr-namespace:FlagstoneUI.Core.Controls;assembly=FlagstoneUI.Core"
  xmlns:converters="clr-namespace:FlagstoneUI.SampleApp.Converters"
  xmlns:local="clr-namespace:FlagstoneUI.SampleApp"
  xmlns:page="clr-namespace:FlagstoneUI.SampleApp.Pages"
  Title="FlagstoneUI.SampleApp">
  <fs:FsShell.Resources>
    <converters:TabSelectedToEmojiConverter SelectedValue="🐵"
                                            UnselectedValue="🙈"
                                            x:Key="EmojiConverter"/>
  </fs:FsShell.Resources>
  <fs:FsShell.TabBarItemTemplate>
    <DataTemplate>
      <HorizontalStackLayout Spacing="4"
                             Padding="12,8"
                             HorizontalOptions="Center"
                             x:DataType="fs:FsTabContext">
        <Label Text="{Binding IsSelected, Converter={StaticResource EmojiConverter}}"
               FontSize="14"
               x:Name="IconLabel"/>
        <Label Text="{Binding Title}" FontSize="14" />
      </HorizontalStackLayout>
    </DataTemplate>
  </fs:FsShell.TabBarItemTemplate>

  <!-- Bottom tabs are declared as a single TabBar (one ShellItem with multiple sections) so the
         FlagstoneUI bar persists while navigating between tabs. The FsTabBar replaces the native
         BottomNavigationView; no platform code is required of the consumer. -->
  <TabBar>
    <ShellContent
      Title="Controls"
      Route="ControlsShowcase">
      <page:ControlsShowcasePage/>
    </ShellContent>

    <ShellContent
      Title="Home"
      Content="{local:MainPage}"
      Route="MainPage" />

    <ShellContent
      Title="Sign In"
      Content="{page:SignInPage}"
      Route="SignInPage" />

    <ShellContent
      Title="Editor"
      Content="{page:FsEditorPage}"
      Route="FsEditorPage" />
  </TabBar>

</fs:FsShell>