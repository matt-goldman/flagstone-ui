<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:fs="clr-namespace:FlagstoneUI.Core.Controls;assembly=FlagstoneUI.Core"
             x:Class="FlagstoneUI.SampleApp.MainPage">
    <ContentPage.Resources>
        <Style x:Key="InvalidFsEntryStyle" TargetType="fs:FsEntry">
            <Setter Property="BorderBrush" Value="{DynamicResource Color.Error}" />
            <Setter Property="TextColor" Value="Red" />
            <Setter Property="BorderWidth" Value="2" />
        </Style>

        <Style x:Key="ValidFsEntryStyle" TargetType="fs:FsEntry">
            <Setter Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
        </Style>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="{DynamicResource Color.Error}" />
            <Setter Property="IsPassword" Value="True"/>
        </Style>
        <Style x:Key="ValidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="{DynamicResource Color.Primary}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="FlagstoneUI"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Per-Edge Borders"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2" />

            <!-- Example 1: Shorthand - Single value (uniform border) -->
            <fs:FsCard
                Border="2 Blue"
                Padding="16"
                CornerRadius="8">
                <Label Text="Uniform border using shorthand: Border=&quot;2 Blue&quot;" />
            </fs:FsCard>

            <!-- Example 2: Shorthand - Two values (vertical, horizontal) -->
            <fs:FsEntry
                Placeholder="Email with shorthand"
                Border="1 Black, 2 Grey"
                Padding="8,4" />

            <!-- Example 3: Shorthand - Four values (TRBL) for 3D effect -->
            <fs:FsCard
                Border="2 White, 2 Gray, 2 Gray, 2 White"
                Padding="16"
                CornerRadius="8">
                <Label Text="3D effect using shorthand (TRBL)" />
            </fs:FsCard>

            <!-- Example 4: Bottom border only (underline style) - explicit -->
            <fs:FsEntry
                Placeholder="Email (bottom border only - explicit)"
                BorderBottomThickness="2"
                BorderBottomBrush="{DynamicResource Color.Primary}"
                Padding="8,4" />

            <!-- Example 5: Card with 3D inset/outset effect - explicit -->
            <fs:FsCard
                Padding="16"
                CornerRadius="8"
                BorderTopThickness="2"
                BorderLeftThickness="2"
                BorderRightThickness="2"
                BorderBottomThickness="2"
                BorderTopBrush="White"
                BorderLeftBrush="White"
                BorderRightBrush="Gray"
                BorderBottomBrush="Gray">
                <Label Text="Card with 3D raised effect (explicit)" />
            </fs:FsCard>

            <!-- Example 6: Card with bottom border divider -->
            <fs:FsCard
                Padding="16"
                BorderBottomThickness="2"
                BorderBottomBrush="{DynamicResource Color.Outline}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Card Title" FontAttributes="Bold" />
                    <Label Text="This card has a bottom border divider" />
                </VerticalStackLayout>
            </fs:FsCard>

            <Label
                Text="Validation"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2" />

            <fs:FsEntry Placeholder="Enter your email"
                        x:Name="ValidatedEntry">
                <fs:FsEntry.Behaviors>
                    <toolkit:EmailValidationBehavior
            InvalidStyle="{DynamicResource InvalidFsEntryStyle}"
            ValidStyle="{DynamicResource ValidFsEntryStyle}"
            ValuePropertyName="Text"
            Flags="ValidateOnValueChanged"/>
                </fs:FsEntry.Behaviors>
            </fs:FsEntry>

            <Entry Placeholder="Enter an email">
                <Entry.Behaviors>
                    <toolkit:TextValidationBehavior
            MinimumLength="5"
            MaximumLength="10"
            InvalidStyle="{DynamicResource InvalidEntryStyle}"
            ValidStyle="{DynamicResource ValidEntryStyle}"
            Flags="ValidateOnValueChanged"/>
                </Entry.Behaviors>
            </Entry>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
