<?xml version="1.0" encoding="utf-16"?>
<ResourceDictionary xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns="http://schemas.microsoft.com/dotnet/2021/maui">
    <!-- ===== Color Tokens ===== -->
    <!-- Color.Dark: Dark semantic color (Bootstrap dark) -->
    <Color x:Key="Color.Dark">#7B8A8B</Color>
    <!-- Color.Error: Error/danger state color -->
    <Color x:Key="Color.Error">#E74C3C</Color>
    <!-- Color.Info: Info state color -->
    <Color x:Key="Color.Info">#3498DB</Color>
    <!-- Color.Light: Light semantic color (Bootstrap light) -->
    <Color x:Key="Color.Light">#ECF0F1</Color>
    <!-- Color.OnDark: Auto-generated on-color for Color.Dark -->
    <Color x:Key="Color.OnDark">#000000</Color>
    <!-- Color.OnError: Auto-generated on-color for Color.Error -->
    <Color x:Key="Color.OnError">#FFFFFF</Color>
    <!-- Color.OnInfo: Auto-generated on-color for Color.Info -->
    <Color x:Key="Color.OnInfo">#000000</Color>
    <!-- Color.OnLight: Auto-generated on-color for Color.Light -->
    <Color x:Key="Color.OnLight">#000000</Color>
    <!-- Color.OnPrimary: Auto-generated on-color for Color.Primary -->
    <Color x:Key="Color.OnPrimary">#FFFFFF</Color>
    <!-- Color.OnSecondary: Auto-generated on-color for Color.Secondary -->
    <Color x:Key="Color.OnSecondary">#000000</Color>
    <!-- Color.OnSuccess: Auto-generated on-color for Color.Success -->
    <Color x:Key="Color.OnSuccess">#000000</Color>
    <!-- Color.OnSurface: Auto-generated on-color for Color.Surface -->
    <Color x:Key="Color.OnSurface">#000000</Color>
    <!-- Color.OnSurfaceVariant.Dark: Auto-generated on-color for Color.SurfaceVariant.Dark -->
    <Color x:Key="Color.OnSurfaceVariant.Dark">#000000</Color>
    <!-- Color.OnWarning: Auto-generated on-color for Color.Warning -->
    <Color x:Key="Color.OnWarning">#000000</Color>
    <!-- Color.Primary: Primary brand color -->
    <Color x:Key="Color.Primary">#2C3E50</Color>
    <!-- Color.Secondary: Secondary brand color -->
    <Color x:Key="Color.Secondary">#95A5A6</Color>
    <!-- Color.Success: Success state color -->
    <Color x:Key="Color.Success">#18BC9C</Color>
    <!-- Color.Surface: Light surface color -->
    <Color x:Key="Color.Surface">#ECF0F1</Color>
    <!-- Color.SurfaceVariant.Dark: Dark surface variant -->
    <Color x:Key="Color.SurfaceVariant.Dark">#7B8A8B</Color>
    <!-- Color.Warning: Warning state color -->
    <Color x:Key="Color.Warning">#F39C12</Color>
<!-- ===== Corner Radius Tokens ===== --><!-- Radius.Breadcrumb: Corner radius from breadcrumb-border-radius --><x:Double x:Key="Radius.Breadcrumb">4</x:Double>
</ResourceDictionary>